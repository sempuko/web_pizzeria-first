---
// 09 — Une table vous attend. The closing frame mirrors the opening one:
// same letterbox, same oven, title crossing the frame edge, credits ending on « Fine ».
import { photo } from '../../lib/photo';

const four = photo('four');
---

<section
  id="reserver"
  class="fi relative h-[100svh] min-h-[620px] lg:h-[92vh] lg:min-h-[680px] overflow-clip bg-nuit text-bougie font-archivo"
  data-nav-section="none"
>
  <div class="absolute inset-x-0 top-[8vh] bottom-[38%] lg:top-[9vh] lg:bottom-[150px] overflow-clip">
    <div class="absolute inset-0" data-reveal="curtain" data-flow>
      <img
        src={four.src}
        srcset={four.srcset}
        sizes="100vw"
        alt=""
        class="fi-photo h-full w-full object-cover"
        style="object-position: 50% 30%"
        loading="lazy"
      />
    </div>
    <div class="fi-shade absolute inset-0" aria-hidden="true"></div>
    <p
      class="absolute left-1/2 bottom-[30%] -translate-x-1/2 whitespace-nowrap font-news italic text-[clamp(19px,2vw,30px)]"
      style="font-variation-settings: 'opsz' 24; text-shadow: 0 1px 12px rgb(21 14 10 / 0.6)"
    >
      Ce soir, demain, ou dans dix ans.
    </p>
  </div>

  <h2
    class="absolute z-10 inset-x-5 top-[calc(62%-0.56em)] lg:inset-x-[3.4vw] lg:top-auto lg:bottom-[calc(150px-0.45em)] flex flex-wrap lg:flex-nowrap justify-between uppercase leading-[0.9] lg:leading-[0.8] text-[9.4vw] lg:text-[min(5.5vw,110px)] pointer-events-none"
    style="font-variation-settings: 'wdth' 125; font-weight: 250"
    data-reveal="lines"
    aria-label="Une table vous attend."
  >
    {
      ['Une', 'table', 'vous', 'attend.'].map((w, i) => (
        <>
          <span class="line" style={`--i:${i}; --delay: 400ms`} aria-hidden="true">
            <span>{w}</span>
          </span>
          {i === 1 && <span class="basis-full h-0 lg:hidden" aria-hidden="true" />}
        </>
      ))
    }
  </h2>

  <!-- Closing credits -->
  <footer class="absolute inset-x-0 bottom-0 flex flex-col gap-6 px-5 pb-6 lg:h-[150px] lg:grid lg:grid-cols-[1fr_auto_1fr] lg:items-end lg:gap-0 lg:px-[3.4vw] lg:pb-[26px] text-[13px]">
    <div class="order-2 lg:order-none leading-[1.65] text-bougie/70">
      <p>La Stella d’Oro, pizzeria, cucina italiana</p>
      <p>3 rue Jacques Stella, 69002 Lyon</p>
    </div>
    <div class="order-1 lg:order-none flex flex-wrap items-center gap-x-7 gap-y-3">
      <a href="tel:+33478000000" class="fi-cta press bg-braise px-6 py-[14px] lg:py-3 text-[15px] lg:text-[14px] font-medium text-nuit">Réserver une table</a>
      <a href="tel:+33478000000" class="fi-tel tabular-nums text-bougie/75">ou le 04 78 00 00 00</a>
    </div>
    <p class="order-3 lg:order-none absolute right-5 bottom-6 lg:static lg:text-right font-news italic text-[22px] text-bougie/80" style="font-variation-settings: 'opsz' 20">Fine</p>
  </footer>
</section>

<style>
  .fi-photo {
    filter: brightness(0.6) saturate(0.9) contrast(1.08) sepia(0.08);
  }
  .fi-shade {
    background: radial-gradient(120% 90% at 50% 40%, transparent 45%, rgb(21 14 10 / 0.6) 100%);
  }
  .fi-cta:hover {
    background: var(--color-bougie);
  }
  .fi-tel {
    transition: color 200ms ease;
  }
  .fi-tel:hover {
    color: var(--color-bougie);
  }
</style>
