---
// 08 — Nous trouver. The address as the hero title's twin, then a ruled timetable.
// PLACEHOLDER: hours and phone number are not known yet; walking times are approximate.

const maps = 'https://www.google.com/maps/search/?api=1&query=3+rue+Jacques+Stella+69002+Lyon';

const walks = [
  { place: 'Place de la République', time: '1 min' },
  { place: 'Cordeliers, métro A', time: '5 min' },
  { place: 'Bellecour, métro A et D', time: '8 min' },
];
---

<section
  id="infos"
  class="relative bg-papier text-nuit px-5 pt-[clamp(100px,15vh,160px)] pb-[clamp(80px,11vh,130px)] lg:px-[3.4vw] lg:pt-[clamp(130px,19vh,200px)] lg:pb-[clamp(100px,14vh,150px)] font-archivo"
  data-nav-section="infos"
>
  <!-- Mobile: a staircase (left, centre, right). Desktop: one justified line, like the hero title -->
  <h2
    class="flex flex-col lg:flex-row lg:justify-between uppercase leading-[0.92] lg:leading-[0.85] text-[15vw] md:text-[11vw] lg:text-[5.7vw]"
    style="font-variation-settings: 'wdth' 125; font-weight: 250"
    data-reveal="lines"
    aria-label="3 rue Jacques Stella"
  >
    {
      ['3 rue', 'Jacques', 'Stella'].map((w, i) => (
        <span class:list={['line', ['self-start', 'self-center', 'self-end'][i], 'lg:self-auto']} style={`--i:${i}`} aria-hidden="true">
          <span>{w}</span>
        </span>
      ))
    }
  </h2>

  <div class="mt-6 grid gap-1 lg:grid-cols-3 text-[13px] lg:text-[14px] text-nuit/70">
    <p>69002 Lyon</p>
    <p class="lg:text-center tabular-nums">45°45′ N, 4°50′ E</p>
    <p class="lg:text-right">À deux pas de la place de la République</p>
  </div>

  <div class="mt-12 lg:mt-[9vh] h-[1.5px] bg-nuit" data-reveal="rule"></div>

  <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-[1fr_1fr_1.35fr_0.85fr]">
    <div class="py-7 md:pr-8 lg:pb-0">
      <h3 class="font-news italic text-[15px] text-nuit/70" style="font-variation-settings: 'opsz' 12">Horaires</h3>
      <dl class="mt-4 font-news text-[21px] leading-[1.5]" style="font-variation-settings: 'opsz' 20">
        <dt class="sr-only">Jours d’ouverture</dt>
        <dd>Du mardi au samedi</dd>
        <dt class="sr-only">Midi</dt>
        <dd class="tabular-nums">12h00 à 14h00</dd>
        <dt class="sr-only">Soir</dt>
        <dd class="tabular-nums">19h00 à 22h30</dd>
      </dl>
      <p class="mt-3 text-[13px] text-nuit/70">Fermé le dimanche et le lundi</p>
    </div>

    <div class="border-t md:border-t-0 md:border-l border-nuit/20 py-7 md:px-8 lg:pb-0">
      <h3 class="font-news italic text-[15px] text-nuit/70" style="font-variation-settings: 'opsz' 12">Téléphone</h3>
      <a href="tel:+33478000000" class="if-tel mt-4 block whitespace-nowrap font-news text-[30px] lg:text-[clamp(24px,2.1vw,32px)] leading-tight tabular-nums" style="font-variation-settings: 'opsz' 36">
        04 78 00 00 00
      </a>
      <p class="mt-3 text-[13px] leading-relaxed text-nuit/70">Pour réserver, ou commander à emporter.</p>
    </div>

    <div class="border-t lg:border-t-0 lg:border-l border-nuit/20 py-7 md:pr-8 lg:px-8 lg:pb-0">
      <h3 class="font-news italic text-[15px] text-nuit/70" style="font-variation-settings: 'opsz' 12">À pied</h3>
      <ul class="mt-4">
        {
          walks.map((w) => (
            <li class="flex items-baseline justify-between border-b border-nuit/12 py-[9px] text-[15px]">
              <span>{w.place}</span>
              <span class="ml-4 whitespace-nowrap tabular-nums text-nuit/70">{w.time}</span>
            </li>
          ))
        }
      </ul>
    </div>

    <div class="border-t lg:border-t-0 md:border-l border-nuit/20 py-7 md:px-8 lg:pr-0 lg:pb-0 flex flex-col gap-4">
      <h3 class="font-news italic text-[15px] text-nuit/70" style="font-variation-settings: 'opsz' 12">Venir</h3>
      <a href={maps} target="_blank" rel="noopener" class="u-link self-start text-[15px]">
        Ouvrir l’itinéraire
      </a>
      <a href="#reserver" class="if-book press mt-2 lg:mt-auto self-start bg-nuit px-5 py-3 text-[14px] text-bougie">Réserver une table</a>
    </div>
  </div>
</section>

<style>
  .if-tel {
    transition: color 200ms ease;
  }
  .if-tel:hover,
  .u-link:hover {
    color: var(--color-tomate);
  }
  .if-book:hover {
    background: var(--color-tomate);
  }
</style>
