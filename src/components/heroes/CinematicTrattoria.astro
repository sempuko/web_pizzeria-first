---
// 02 — Cinematic Trattoria · « La saracinesca »
// 19h, rue Jacques Stella: the shutter rolls up and the evening begins.
// The letterbox holds the interface; the frame holds only the title and a subtitle.

const scenes = [
  {
    id: 'four',
    label: 'Le four',
    src: '/img/four.jpg',
    position: '50% 58%',
    subtitle: 'Ce soir, on vous garde une table.',
  },
  {
    id: 'salle',
    label: 'La salle',
    src: '/img/brindisi.jpg',
    position: '50% 45%',
    subtitle: 'Comme à la maison.',
  },
  {
    id: 'paton',
    label: 'Le pâton',
    src: '/img/calzone-mains.jpg',
    position: '50% 58%',
    subtitle: 'Généreux, comme toujours.',
  },
];
---

<section
  id="etude-02"
  class="ct relative h-svh min-h-[720px] overflow-hidden bg-nuit text-bougie font-archivo"
  data-ct
>
  <!-- Top letterbox: navigation as opening credits -->
  <header class="absolute inset-x-0 top-0 z-30 h-[72px] flex items-center px-[3.4vw] text-[13px]">
    <a
      href="#etude-02"
      class="flex items-center gap-3 uppercase tracking-[0.32em]"
      style="font-variation-settings: 'wdth' 125; font-weight: 500"
    >
      <svg class="w-[11px] h-[11px] fill-laiton" viewBox="0 0 24 24" aria-hidden="true">
        <path d="M12 1.5l2.9 7.3 7.6.5-5.9 4.9 1.9 7.6L12 17.6l-6.5 4.2 1.9-7.6L1.5 9.3l7.6-.5z" />
      </svg>
      Stella d’Oro
    </a>
    <nav class="ml-auto flex items-center gap-9 tracking-[0.04em]" aria-label="Navigation principale">
      <a class="ct-link" href="#">La carte</a>
      <a class="ct-link" href="#">Nous trouver</a>
      <a
        class="ct-cta border border-laiton/60 px-4 py-[9px] text-bougie"
        href="#">Réserver une table</a
      >
    </nav>
  </header>

  <!-- The frame -->
  <div class="ct-frame absolute inset-x-0 top-[72px] bottom-[150px] overflow-hidden">
    <div class="ct-drift absolute -inset-[3%]">
      {
        scenes.map((s, i) => (
          <img
            src={s.src}
            alt=""
            data-scene={s.id}
            class:list={['ct-scene absolute inset-0 h-full w-full object-cover', { 'is-active': i === 0 }]}
            style={`object-position:${s.position}`}
            decoding="async"
          />
        ))
      }
    </div>
    <!-- Grade: a printed-light vignette so cream type holds on the image -->
    <div class="ct-grade pointer-events-none absolute inset-0" aria-hidden="true"></div>

    <!-- Subtitle, set like a film subtitle -->
    <p
      class="ct-subtitle absolute left-1/2 bottom-[26%] -translate-x-1/2 whitespace-nowrap font-news italic text-[clamp(20px,2vw,30px)] text-bougie"
      style="font-variation-settings: 'opsz' 24"
      aria-live="polite"
    >
      {scenes[0].subtitle}
    </p>


    <!-- The shutter -->
    <div class="ct-shutter absolute inset-0 z-20" aria-hidden="true">
      <div class="ct-shutter-bar absolute inset-x-0 bottom-0 h-[18px]"></div>
    </div>
  </div>

    <!-- Title: crosses the frame edge — half in the picture, half in the letterbox -->
    <h1
      class="ct-title absolute z-30 inset-x-[3.4vw] bottom-[calc(150px-3.7vw)] pointer-events-none flex justify-between uppercase leading-[0.8] text-[8.6vw] text-bougie"
      style="font-variation-settings: 'wdth' 125; font-weight: 250"
    >
      <span class="ct-word">La</span><span class="ct-word">Stella</span><span class="ct-word">d’Oro</span>
    </h1>

  <!-- Bottom letterbox: credits and the scene picker -->
  <footer
    class="absolute inset-x-0 bottom-0 z-30 h-[150px] grid grid-cols-[1fr_auto_1fr] items-end pb-[26px] px-[3.4vw] text-[13px]"
  >
    <div class="leading-[1.65] text-bougie/70">
      <p>Pizzeria, cucina italiana</p>
      <p>3 rue Jacques Stella, Lyon 2<sup>e</sup></p>
    </div>

    <ol class="flex gap-10" aria-label="Scènes">
      {
        scenes.map((s, i) => (
          <li>
            <button
              type="button"
              class="ct-pick group relative pt-4 text-left"
              data-target={s.id}
              data-subtitle={s.subtitle}
              aria-pressed={i === 0 ? 'true' : 'false'}
            >
              <span class="ct-pick-rule absolute left-0 top-0 h-px w-full bg-bougie/25">
                <span class="ct-pick-fill absolute inset-0 origin-left bg-braise" />
              </span>
              <span class="tabular-nums text-bougie/45 mr-2">{String(i + 1).padStart(2, '0')}</span>
              <span class="ct-pick-label">{s.label}</span>
            </button>
          </li>
        ))
      }
    </ol>

    <div class="flex justify-end">
      <a class="ct-link text-[14px]" href="#">Voir la carte</a>
    </div>
  </footer>
</section>

<style>
  .ct-scene {
    opacity: 0;
    filter: blur(8px);
    transform: scale(1.04);
    transition:
      opacity 1100ms var(--ease-out-strong),
      filter 1100ms var(--ease-out-strong),
      transform 2400ms var(--ease-out-strong);
  }
  .ct-scene.is-active {
    opacity: 1;
    filter: blur(0);
    transform: scale(1);
  }

  /* Lights on: the frame starts as an unlit room and warms as the shutter rises */
  .ct-drift {
    filter: brightness(0.25) saturate(0.6);
    will-change: transform;
  }
  [data-ct].is-open .ct-drift {
    filter: brightness(0.86) saturate(0.95) contrast(1.06);
    transition: filter 2200ms ease 500ms;
  }

  .ct-grade {
    background:
      radial-gradient(120% 90% at 50% 40%, transparent 45%, rgb(21 14 10 / 0.55) 100%),
      linear-gradient(to top, rgb(21 14 10 / 0.6), transparent 42%);
  }

  /* Ribbed steel shutter (saracinesca) */
  .ct-shutter {
    background-color: #2a221c;
    background-image: repeating-linear-gradient(
      to bottom,
      #3a3029 0 2px,
      #2a221c 2px 13px,
      #1a1410 13px 15px
    );
    transform: translateY(0);
  }
  .ct-shutter-bar {
    background: #463a30;
    border-top: 1px solid #5a4b3e;
  }
  [data-ct].is-open .ct-shutter {
    transform: translateY(-101%);
    transition: transform 1700ms var(--ease-in-out-strong) 250ms;
  }

  .ct-word {
    display: inline-block;
    opacity: 0;
    transform: translateY(18%);
  }
  [data-ct].is-open .ct-word {
    opacity: 1;
    transform: none;
    transition:
      opacity 900ms ease,
      transform 1200ms var(--ease-out-strong);
  }
  [data-ct].is-open .ct-word:nth-child(1) {
    transition-delay: 1500ms;
  }
  [data-ct].is-open .ct-word:nth-child(2) {
    transition-delay: 1600ms;
  }
  [data-ct].is-open .ct-word:nth-child(3) {
    transition-delay: 1700ms;
  }

  .ct-subtitle {
    text-shadow: 0 1px 12px rgb(21 14 10 / 0.6);
    opacity: 0;
  }
  [data-ct].is-open .ct-subtitle {
    opacity: 1;
    transition: opacity 600ms ease 2300ms, filter 300ms ease;
  }
  [data-ct].is-open .ct-subtitle.is-ready {
    transition: opacity 420ms ease, filter 420ms ease;
  }
  .ct-subtitle.is-swapping {
    opacity: 0 !important;
    filter: blur(4px);
    transition: opacity 220ms ease, filter 220ms ease !important;
  }

  .ct-pick-fill {
    transform: scaleX(0);
    transition: transform 500ms var(--ease-out-strong);
  }
  .ct-pick[aria-pressed='true'] .ct-pick-fill {
    transform: scaleX(1);
  }
  .ct-pick-label {
    transition: color 200ms ease;
    color: rgb(241 226 196 / 0.6);
  }
  .ct-pick:hover .ct-pick-label,
  .ct-pick[aria-pressed='true'] .ct-pick-label {
    color: var(--color-bougie);
  }

  .ct-link {
    opacity: 0.78;
    transition: opacity 200ms ease;
  }
  .ct-link:hover,
  .ct-link:focus-visible {
    opacity: 1;
  }
  .ct-cta {
    transition:
      background-color 220ms ease,
      color 220ms ease,
      border-color 220ms ease,
      transform 160ms var(--ease-out-strong);
  }
  .ct-cta:hover {
    background: var(--color-braise);
    border-color: var(--color-braise);
    color: var(--color-nuit);
  }
  .ct-cta:active {
    transform: scale(0.97);
  }

  @media (prefers-reduced-motion: reduce) {
    .ct-shutter {
      display: none;
    }
    .ct-drift {
      filter: brightness(0.86) saturate(0.95) contrast(1.06);
    }
    .ct-word,
    .ct-subtitle {
      opacity: 1;
      transform: none;
    }
  }
</style>

<script>
  const root = document.querySelector<HTMLElement>('[data-ct]');

  if (root) {
    const frame = root.querySelector<HTMLElement>('.ct-frame')!;
    const drift = root.querySelector<HTMLElement>('.ct-drift')!;
    const subtitle = root.querySelector<HTMLElement>('.ct-subtitle')!;
    const scenes = [...root.querySelectorAll<HTMLImageElement>('.ct-scene')];
    const picks = [...root.querySelectorAll<HTMLButtonElement>('.ct-pick')];
    const reduced = window.matchMedia('(prefers-reduced-motion: reduce)').matches;

    // The shutter rises once, when the study is first in view.
    const observer = new IntersectionObserver(
      (records) => {
        if (records.some((r) => r.isIntersecting)) {
          document.fonts.ready.then(() => requestAnimationFrame(() => root.classList.add('is-open')));
          observer.disconnect();
        }
      },
      { threshold: 0.4 },
    );
    observer.observe(root);

    // Handheld drift: the frame follows the cursor with damping, never 1:1.
    if (!reduced) {
      let tx = 0;
      let ty = 0;
      let x = 0;
      let y = 0;
      let raf = 0;

      const tick = () => {
        x += (tx - x) * 0.05;
        y += (ty - y) * 0.05;
        drift.style.transform = `translate3d(${x.toFixed(2)}px, ${y.toFixed(2)}px, 0)`;
        raf = Math.abs(tx - x) > 0.05 || Math.abs(ty - y) > 0.05 ? requestAnimationFrame(tick) : 0;
      };
      const kick = () => {
        if (!raf) raf = requestAnimationFrame(tick);
      };

      frame.addEventListener('pointermove', (e) => {
        const r = frame.getBoundingClientRect();
        tx = ((e.clientX - r.left) / r.width - 0.5) * -22;
        ty = ((e.clientY - r.top) / r.height - 0.5) * -14;
        kick();
      });
      frame.addEventListener('pointerleave', () => {
        tx = 0;
        ty = 0;
        kick();
      });
    }

    // Scene picker: a slow crossfade with a little blur, like a lap dissolve.
    picks.forEach((pick) => {
      pick.addEventListener('click', () => {
        if (pick.getAttribute('aria-pressed') === 'true') return;
        picks.forEach((p) => p.setAttribute('aria-pressed', String(p === pick)));
        scenes.forEach((s) => s.classList.toggle('is-active', s.dataset.scene === pick.dataset.target));

        subtitle.classList.add('is-ready', 'is-swapping');
        window.setTimeout(() => {
          subtitle.textContent = pick.dataset.subtitle ?? '';
          subtitle.classList.remove('is-swapping');
        }, reduced ? 0 : 380);
      });
    });
  }
</script>
