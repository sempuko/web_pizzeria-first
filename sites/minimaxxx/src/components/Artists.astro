---
// 0006—Artists, as their own festival posters: an overexposed white-out, club fog drifting through,
// a thin technical grid, labels in > brackets <, the line-up stacked in the middle.
// Black type on white haze, with a white halation around it: their glow, at full contrast.
import Picto from './Picto.astro';
import { festival, contact } from '../content/site';

const mail = `mailto:${contact.email}?subject=${encodeURIComponent('Line-up')}`;
---

<section id="artists" class="artists" data-artists>
  <canvas class="artists-fog" data-fog aria-hidden="true"></canvas>
  <span class="artists-grid" aria-hidden="true"></span>

  <div class="poster framed">
    <div class="poster-top fine">
      <p>Minimaxxx {festival.name}<br />&gt;{festival.venue}&lt;<br />Pantin</p>
      <p class="poster-when">&gt; Night &lt;<br />{festival.night}</p>
      <p class="poster-top-r">Second-hand fashion<br />+ music festival<br />{festival.rooms}</p>
    </div>

    <h2 class="head"><span class="n">0006</span>—Artists<span class="tag">[Music//Performance]</span></h2>

    <div class="lineup">
      <p class="kind fine">Lives</p>
      <ul class="names" data-names>
        {festival.lives.map((n) => <li><span>{n}</span></li>)}
      </ul>
      <p class="kind fine">DJ-sets</p>
      <ul class="names" data-names>
        {festival.djs.map((n) => <li><span>{n}</span></li>)}
      </ul>
    </div>

    <p class="date" aria-label={`${festival.dates}`}>
      <span aria-hidden="true">13+14</span><span class="date-month" aria-hidden="true">Dec. 25</span>
    </p>
    <p class="title">Minimaxxx {festival.name}</p>

    <ul class="boxes fine">
      <li>Minimaxxx</li>
      <li>{festival.edition}</li>
      <li>&gt;{festival.venue}&lt; {festival.address}</li>
      <li>{festival.rooms}</li>
      <li class="box-caution"><Picto name="hot" />Caution</li>
    </ul>

    <div class="poster-call">
      <p class="l">DJ-set, live, performance : joue au prochain Minimaxxx.</p>
      <a class="btn btn-solid" href={mail}>Envoyer mon set</a>
    </div>
  </div>
</section>

<script>
  import { initSmoke } from '../scripts/smoke';
  import { glitchEvery } from '../scripts/glitch';

  const section = document.querySelector<HTMLElement>('[data-artists]');
  const fog = section?.querySelector<HTMLCanvasElement>('[data-fog]');
  if (section && fog) {
    const phone = window.matchMedia('(max-width: 720px)').matches;
    initSmoke(fog, { rise: 1.25, strength: 0.85, scale: phone ? 0.28 : 0.38, area: section });
    // Now and then one name tears, like a frame of the projected poster dropping.
    section.querySelectorAll<HTMLElement>('[data-names] li span').forEach((name) => glitchEvery(name, 5000, 14000));
  }
</script>

<style>
  /* White-out: grey at the top where the fog shows, a hot light behind the line-up, white at the floor. */
  .artists {
    position: relative;
    isolation: isolate;
    overflow: clip;
    color: var(--black);
    background:
      radial-gradient(ellipse 60% 42% at 50% 46%, rgb(255 255 255 / 0.95), rgb(255 255 255 / 0) 100%),
      linear-gradient(to bottom, #b4b4b4, #d2d2d2 38%, #efefef 78%, #fff);
  }

  .artists-fog {
    position: absolute;
    inset: 0;
    width: 100%;
    height: 100%;
    z-index: -1;
    mix-blend-mode: screen;
  }

  .artists-grid {
    position: absolute;
    inset: 0;
    z-index: -1;
    background-image:
      linear-gradient(rgb(0 0 0 / 0.07) 1px, transparent 1px),
      linear-gradient(90deg, rgb(0 0 0 / 0.07) 1px, transparent 1px);
    background-size: 44px 44px;
    background-position: center top;
  }

  .poster {
    display: flex;
    flex-direction: column;
    align-items: center;
    padding-block: 14vh 10vh;
    text-align: center;
  }

  .poster-top {
    align-self: stretch;
    display: grid;
    grid-template-columns: 1fr auto 1fr;
    gap: 16px;
    text-align: left;
  }

  .poster-when {
    text-align: center;
    font-size: max(var(--fs-s), 12px);
    font-weight: 800;
  }

  .poster-top-r {
    text-align: right;
  }

  .head {
    justify-content: center;
    margin-top: 10vh;
  }

  /* Halation: black type with a white bloom around it, the overexposed print of their posters.
     Done as a filter on its own layer (GPU blur) rather than text-shadow, so scrolling stays smooth. */
  .names,
  .date,
  .title,
  .head {
    filter: drop-shadow(0 0 0.05em rgb(255 255 255 / 0.95)) drop-shadow(0 0 0.32em rgb(255 255 255 / 0.75));
    will-change: filter;
  }

  .lineup {
    margin-top: 6vh;
  }

  .kind {
    margin: 3.4vh 0 1vh;
    font-size: max(var(--fs-s), 11px);
  }

  .names {
    position: relative;
    font-size: clamp(2.6rem, 8.2vw, 8rem);
    font-weight: 900;
    font-stretch: 68%;
    line-height: 0.84;
    letter-spacing: -0.035em;
  }

  .names li {
    position: relative;
  }

  .names li span {
    display: inline-block;
  }

  .date {
    display: flex;
    align-items: flex-start;
    justify-content: center;
    margin-top: 10vh;
    font-size: clamp(5rem, 22vw, 20rem);
    font-weight: 250;
    font-stretch: 100%;
    line-height: 0.78;
    letter-spacing: -0.06em;
  }

  .date-month {
    margin: 0.1em 0 0 0.12em;
    font-size: 0.16em;
    font-weight: 500;
    letter-spacing: -0.01em;
    white-space: nowrap;
  }

  .title {
    margin-top: 1vh;
    font-size: var(--fs-xl);
    font-weight: 900;
    font-stretch: 70%;
    line-height: 0.85;
    letter-spacing: -0.035em;
  }

  /* The boxed footer strip of their posters. */
  .boxes {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    margin-top: 6vh;
  }

  .boxes li {
    display: flex;
    align-items: center;
    gap: 6px;
    padding: 7px 12px;
    border: 1px solid var(--black);
    margin: 0 -1px -1px 0;
    background: rgb(255 255 255 / 0.35);
  }

  .box-caution :global(.picto) {
    font-size: 13px;
  }

  .poster-call {
    align-self: stretch;
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    flex-wrap: wrap;
    gap: 20px var(--gutter);
    margin-top: 12vh;
    padding-top: 18px;
    border-top: 1px solid var(--black);
    text-align: left;
  }

  .poster-call .l {
    max-width: 17em;
  }

  @media (max-width: 720px) {
    .poster-top {
      grid-template-columns: 1fr 1fr;
    }

    .poster-when {
      grid-column: 1 / -1;
      grid-row: 1;
    }
  }
</style>
