---
// 06 — Ils en parlent. One real quote, said big; the rest as a plain ledger of who said what.
// The quote is read as you scroll: its words light up one after another.
import Words from './Words.astro';
import { press, quote, reviews } from '../content/site';

const quoteWords = quote.text.split(' ');
---

<section id="presse" class="section glaze">
  <div class="wrap">
    <h2 class="h2" data-reveal="words"><Words text="Ils en parlent" /></h2>

    <div class="mt-12 grid gap-14 lg:grid-cols-12 lg:gap-10">
      <figure class="lg:col-span-7">
        <blockquote class="font-gloock text-[clamp(30px,3.3vw,48px)] leading-[1.14] text-balance" data-scroll-words>
          <span class="sw text-rojo">«&#8239;</span>{
            quoteWords.map((w, i) => (
              <Fragment>
                <span class="sw">{w}</span>
                {i < quoteWords.length - 1 ? ' ' : ''}
              </Fragment>
            ))
          }<span class="sw text-rojo">&#8239;»</span>
        </blockquote>
        <figcaption class="mt-6 text-[16px] font-semibold">{quote.source}</figcaption>
      </figure>

      <ul class="lg:col-span-4 lg:col-start-9" data-reveal="rows">
        {
          press.map((p) => (
            <li class="border-t border-marino/18 py-4 last:border-b">
              <p class="text-[16px] font-semibold">{p.who}</p>
              <p class="mt-1 text-[15.5px] leading-snug text-marino/78">{p.what}</p>
            </li>
          ))
        }
      </ul>
    </div>

    {
      reviews.length > 0 && (
        <ul class="mt-16 grid gap-8 md:grid-cols-3">
          {reviews.map((r, i) => (
            <li class="snapshot relative pb-6" style={`transform: rotate(${[-1.5, 1, -0.5][i % 3]}deg)`}>
              <p class="px-3 pt-3 font-hand text-[24px] leading-[1.2]">{r.text}</p>
              <p class="mt-3 px-3 text-[14px] text-marino/70">{r.name}, sur Google</p>
            </li>
          ))}
        </ul>
      )
    }
  </div>
</section>
