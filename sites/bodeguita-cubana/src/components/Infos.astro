---
// 07 — Venir nous voir. Address, today's hours, how to book, and the façade to look for.
import Words from './Words.astro';
import { contact, hoursTable } from '../content/site';
---

<section id="infos" class="section glaze border-t border-marino/12">
  <div class="wrap">
    <h2 class="h2" data-reveal="words"><Words text="Venir nous voir" /></h2>

    <div class="mt-12 grid gap-12 md:grid-cols-2 lg:grid-cols-12 lg:gap-10">
      <div class="lg:col-span-4">
        <p class="font-gloock text-[32px] leading-[1.1]">{contact.street}</p>
        <p class="mt-2 text-[17px] leading-relaxed text-marino/85">
          {contact.city}, {contact.corner}<br />{contact.metro}
        </p>
        <figure class="snapshot relative mt-8 w-[86%] max-w-[360px] -rotate-[1.5deg]" data-reveal="pin" data-tilt="6" data-parallax="-0.06" style="--delay: 150ms">
          <img src="/img/facade.jpg" width="702" height="379" alt="La façade : le mur bleu et l’enseigne en azulejos." loading="lazy" decoding="async" />
          <figcaption class="absolute inset-x-2 bottom-[3px] font-hand text-[19px] leading-none text-marino/80">cherchez le mur bleu</figcaption>
        </figure>
      </div>

      <div class="lg:col-span-4">
        <h3 class="text-[15px] font-semibold text-marino/75">Horaires</h3>
        <dl class="mt-3" data-hours data-reveal="rows">
          {
            hoursTable.map((row) => (
              <div class="hours-row flex items-baseline justify-between gap-4 border-t border-marino/16 py-3" data-days={row.days.join(',')}>
                <dt class="text-[16px]">{row.label}</dt>
                <dd class="text-right text-[16px] tabular-nums text-marino/85">{row.value}</dd>
              </div>
            ))
          }
        </dl>
        <p class="flex items-center gap-[10px] border-t border-marino/16 pt-4 text-[15px] font-medium" data-status>
          <span class="status-dot"></span>
          <span data-status-text>Horaires du jour</span>
        </p>
      </div>

      <div class="lg:col-span-4">
        <h3 class="text-[15px] font-semibold text-marino/75">Réserver</h3>
        <a class="mt-3 block whitespace-nowrap font-gloock text-[clamp(30px,2.6vw,38px)] leading-none" href={contact.phoneHref}>{contact.phone}</a>
        <p class="mt-3 text-[15px] text-marino/75">
          ou par e-mail&#8239;: <a class="u-link" href={`mailto:${contact.email}`}>{contact.email}</a>
        </p>
        <div class="mt-7 flex flex-wrap gap-3">
          <a class="btn btn-rojo" href={contact.booking} target="_blank" rel="noopener" data-magnetic>Réserver une table</a>
          <a class="btn btn-ink" href={contact.directions} target="_blank" rel="noopener">Itinéraire</a>
        </div>
      </div>
    </div>

    <div class="map mt-16 overflow-hidden border border-marino/15 bg-azulejo">
      <iframe
        title="Plan d’accès à la Bodeguita Cubana"
        src={contact.map}
        class="block h-[340px] w-full lg:h-[420px]"
        loading="lazy"
        referrerpolicy="no-referrer-when-downgrade"></iframe>
    </div>
  </div>
</section>

<style>
  /* Today's line gets a painted underline */
  .hours-row.is-today dt,
  .hours-row.is-today dd {
    font-weight: 600;
    color: var(--color-marino);
  }
  .hours-row.is-today dt {
    background-image: linear-gradient(var(--color-sol), var(--color-sol));
    background-size: 100% 6px;
    background-position: 0 92%;
    background-repeat: no-repeat;
  }
  /* ...painted once the timetable has arrived */
  @media (prefers-reduced-motion: no-preference) {
    :global(.js) [data-hours]:not(:global(.is-in)) .is-today dt {
      background-size: 0 6px;
    }
    .hours-row.is-today dt {
      transition: background-size 700ms var(--ease-in-out-strong) 450ms;
    }
  }
</style>

<script>
  import { parisNow } from '../lib/hours';

  const { day } = parisNow();
  document.querySelectorAll<HTMLElement>('[data-hours] [data-days]').forEach((row) => {
    row.classList.toggle('is-today', row.dataset.days!.split(',').map(Number).includes(day));
  });
</script>
